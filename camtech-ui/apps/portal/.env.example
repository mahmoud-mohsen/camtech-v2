# Base URL of the camtech backend (the tenant API lives under /v2/tenant).
# Only the host changes between environments: the service always runs under /camtech-service.
VITE_API_BASE_URL=http://localhost:8080/camtech-service

# Where the end-user SDK (apps/sdk) is served. Used by the Branding live preview, the Playground
# and the code samples in the Integration guide.
VITE_SDK_URL=http://localhost:5175

# true = serve fake data from the in-memory mock layer (no backend needed).
VITE_USE_MOCKS=false
