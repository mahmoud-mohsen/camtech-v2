# Loaded by `npm run dev` (vite's default development mode): talk to the dev camtech-service.
# Override locally in .env.development.local (gitignored), e.g. http://localhost:8080/camtech-service.
VITE_API_BASE_URL=http://localhost:8080/camtech-service
VITE_SDK_URL=http://localhost:5175
VITE_USE_MOCKS=false
